# ==========================================
# EduConnect AI - Environment Variables
# Copy this file to .env or .env.local for local dev
# ==========================================

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon API Key (from Project Settings -> API)
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key

# (Optional) Serverless AI API Key for Vercel deployment (never exposed to browser)
OPENAI_API_KEY=your_openai_api_key_here
